---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <form id="sourceForm" class="max-w-md mx-auto p-8 flex flex-col gap-4">
    <h1 id="formTitle" class="text-xl font-semibold mb-2">Tambah Source Code</h1>

    <label class="flex flex-col gap-1 text-sm">
      Nama
      <input type="text" name="nama" required class="border border-gray-300 rounded-md px-3 py-2" />
    </label>

    <div class="flex flex-col gap-1 text-sm">
      <span>Thumbnail</span>
      <div class="flex gap-2 mb-1">
        <label class="flex items-center gap-1">
          <input type="radio" name="thumbMode" value="url" checked /> URL
        </label>
        <label class="flex items-center gap-1">
          <input type="radio" name="thumbMode" value="upload" /> Upload
        </label>
      </div>

      <input type="text" name="thumbnail" placeholder="https://..."
        class="border border-gray-300 rounded-md px-3 py-2" id="thumbUrl" />
      <input type="file" accept="image/*" name="thumbnailFile"
        class="border border-gray-300 rounded-md px-3 py-2 hidden" id="thumbFile" />

      <img id="preview" alt="Preview" class="mt-2 w-full rounded-md border border-gray-200 hidden" />
    </div>

    <label class="flex flex-col gap-1 text-sm">
      Stack (pisah pakai koma)
      <input type="text" name="stack" placeholder="HTML, CSS, JS" class="border border-gray-300 rounded-md px-3 py-2" />
    </label>

    <label class="flex flex-col gap-1 text-sm">
      Link Download
      <input type="text" name="download" placeholder="https://..." class="border border-gray-300 rounded-md px-3 py-2" />
    </label>

    <p id="formError" class="text-red-600 text-sm hidden"></p>

    <button type="submit" class="bg-gray-900 text-white py-2 rounded-md text-sm">Simpan</button>
  </form>
</Layout>

<script>
  import "../../lib/guard";
  import { getSource, addSource, updateSource, type SourceItem } from "../../lib/source";

  const form = document.getElementById("sourceForm") as HTMLFormElement;
  const errorEl = document.getElementById("formError") as HTMLParagraphElement;
  const titleEl = document.getElementById("formTitle") as HTMLHeadingElement;

  const thumbUrl = document.getElementById("thumbUrl") as HTMLInputElement;
  const thumbFile = document.getElementById("thumbFile") as HTMLInputElement;
  const preview = document.getElementById("preview") as HTMLImageElement;
  const radios = document.querySelectorAll('input[name="thumbMode"]');

  const params = new URLSearchParams(window.location.search);
  const editId = params.get("id");

  function showPreview(src: string) {
    if (src) {
      preview.src = src;
      preview.classList.remove("hidden");
    } else {
      preview.classList.add("hidden");
    }
  }

  radios.forEach((r) => {
    r.addEventListener("change", () => {
      const mode = (r as HTMLInputElement).value;
      if (mode === "url") {
        thumbUrl.classList.remove("hidden");
        thumbFile.classList.add("hidden");
        showPreview(thumbUrl.value);
      } else {
        thumbUrl.classList.add("hidden");
        thumbFile.classList.remove("hidden");
      }
    });
  });
  thumbUrl.addEventListener("input", () => showPreview(thumbUrl.value));
  thumbFile.addEventListener("change", () => {
    const file = thumbFile.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = () => showPreview(reader.result as string);
      reader.readAsDataURL(file);
    }
  });

  if (editId) {
    titleEl.textContent = "Edit Source Code";
    const data = await getSource(editId);
    if (data) {
      (form.nama as HTMLInputElement).value = data.nama;
      thumbUrl.value = data.thumbnail;
      showPreview(data.thumbnail);
      (form.stack as HTMLInputElement).value = data.stack.join(", ");
      (form.download as HTMLInputElement).value = data.download;
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Menyimpan...";

    try {
      let thumbnailUrl = thumbUrl.value.trim();

      const mode = (document.querySelector('input[name="thumbMode"]:checked') as HTMLInputElement).value;
      if (mode === "upload" && thumbFile.files?.[0]) {
        const file = thumbFile.files[0];
        const fd = new FormData();
        fd.append("file", file);

        const res = await fetch("/api/upload", { method: "POST", body: fd });
        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || "Upload gagal");
        }
        const data = await res.json();
        thumbnailUrl = data.url;
      }

      const payload: SourceItem = {
        nama: (form.nama as HTMLInputElement).value.trim(),
        thumbnail: thumbnailUrl,
        stack: (form.stack as HTMLInputElement).value
          .split(",")
          .map((s) => s.trim())
          .filter(Boolean),
        download: (form.download as HTMLInputElement).value.trim(),
      };

      if (editId) {
        await updateSource(editId, payload);
      } else {
        await addSource(payload);
      }
      window.location.href = "/admin";
    } catch (err: any) {
      errorEl.textContent = "Gagal menyimpan: " + (err?.message ?? "unknown error");
      errorEl.classList.remove("hidden");
      submitBtn.disabled = false;
      submitBtn.textContent = "Simpan";
    }
  });
</script>