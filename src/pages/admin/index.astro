---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <div class="min-h-screen bg-gray-50">
    <header class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <h1 class="text-lg font-bold">Bankod Admin</h1>
          <span id="totalBadge" class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">0 item</span>
        </div>
        <div class="flex items-center gap-2">
          <a href="/" target="_blank" class="text-sm text-gray-600 hover:text-gray-900 no-underline px-3 py-1.5">Lihat Situs</a>
          <button id="logoutBtn" class="text-sm border border-gray-300 hover:bg-gray-50 px-3 py-1.5 rounded-md">Logout</button>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-5 gap-6">
      <!-- KIRI: Form -->
      <section class="lg:col-span-2">
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden sticky top-6">
          <div class="p-4 border-b border-gray-200 flex items-start justify-between">
            <div>
              <h2 id="formTitle" class="font-semibold">Tambah Source Code</h2>
              <p id="formSubtitle" class="text-xs text-gray-500 mt-0.5">Isi form lalu simpan.</p>
            </div>
            <button id="newBtn" class="text-xs bg-gray-900 hover:bg-gray-700 text-white px-2.5 py-1 rounded-md whitespace-nowrap">+ Baru</button>
          </div>

          <form id="sourceForm" class="p-4 flex flex-col gap-3">
            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">Nama</span>
              <input type="text" name="nama" required class="border border-gray-300 rounded-md px-3 py-2 text-sm" />
            </label>

            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">Kategori</span>
              <input type="text" name="kategori" placeholder="landing-page" class="border border-gray-300 rounded-md px-3 py-2 text-sm" />
              <div id="katSuggest" class="flex flex-wrap gap-1 mt-1"></div>
            </label>

            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">Stack <span class="text-gray-400 font-normal">(pisah spasi, multi-kata pakai dash)</span></span>
              <input type="text" name="stack" placeholder="next-js tailwind css" class="border border-gray-300 rounded-md px-3 py-2 text-sm" />
              <div id="stackSuggest" class="flex flex-wrap gap-1 mt-1"></div>
            </label>

            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">Link Download</span>
              <input type="text" name="download" placeholder="https://..." class="border border-gray-300 rounded-md px-3 py-2 text-sm" />
            </label>

            <label class="flex flex-col gap-1 text-sm">
              <span class="font-medium">Jumlah Download</span>
              <input type="number" name="downloadCount" min="0" value="0" class="border border-gray-300 rounded-md px-3 py-2 text-sm" />
            </label>

            <div class="flex flex-col gap-1 text-sm">
              <span class="font-medium">Thumbnail</span>
              <div class="flex gap-3 mb-1 text-xs">
                <label class="flex items-center gap-1"><input type="radio" name="thumbMode" value="url" checked /> URL</label>
                <label class="flex items-center gap-1"><input type="radio" name="thumbMode" value="upload" /> Upload</label>
              </div>
              <input type="text" name="thumbnail" placeholder="https://..."
                class="border border-gray-300 rounded-md px-3 py-2 text-sm" id="thumbUrl" />
              <input type="file" accept="image/*" name="thumbnailFile"
                class="border border-gray-300 rounded-md px-3 py-2 text-sm hidden" id="thumbFile" />
              <img id="preview" alt="Preview" class="mt-1 w-full rounded-md border border-gray-200 hidden aspect-video object-cover" />
            </div>

            <p id="formError" class="text-red-600 text-xs hidden"></p>

            <div class="flex gap-2 mt-1">
              <button type="submit" class="flex-1 bg-gray-900 hover:bg-gray-700 text-white py-2 rounded-md text-sm">Simpan</button>
              <button type="button" id="resetBtn" class="px-3 py-2 border border-gray-300 rounded-md text-sm hover:bg-gray-50">Batal</button>
            </div>
          </form>
        </div>
      </section>

      <!-- KANAN: List -->
      <section class="lg:col-span-3">
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
          <div class="p-4 border-b border-gray-200">
            <h2 class="font-semibold">Daftar Source Code</h2>
            <p class="text-xs text-gray-500 mt-0.5">Klik baris untuk mengedit di form kiri.</p>
          </div>
          <p id="loading" class="p-4 text-sm text-gray-500">Memuat data...</p>
          <p id="empty" class="p-4 text-sm text-gray-500 hidden">Belum ada data.</p>
          <div id="list" class="hidden divide-y divide-gray-100"></div>
        </div>
      </section>
    </div>
  </div>

  <div id="deleteModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-xl p-6 w-full max-w-sm mx-4">
      <h2 class="text-lg font-semibold mb-2">Hapus data ini?</h2>
      <p id="deleteName" class="text-sm text-gray-600 mb-6"></p>
      <div class="flex justify-end gap-2">
        <button id="cancelDelete" class="border border-gray-300 px-4 py-2 rounded-md text-sm">Batal</button>
        <button id="confirmDelete" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm">Hapus</button>
      </div>
    </div>
  </div>

  <div id="logoutModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-xl p-6 w-full max-w-sm mx-4">
      <h2 class="text-lg font-semibold mb-2">Keluar dari admin?</h2>
      <p class="text-sm text-gray-600 mb-6">Kamu perlu login lagi untuk mengakses halaman admin.</p>
      <div class="flex justify-end gap-2">
        <button id="cancelLogout" class="border border-gray-300 px-4 py-2 rounded-md text-sm">Batal</button>
        <button id="confirmLogout" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm">Logout</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import "../../lib/guard";
  import { signOut } from "firebase/auth";
  import { auth } from "../../lib/firebase";
  import {
    getSources,
    addSource,
    updateSource,
    deleteSource,
    parseStack,
    type SourceItem,
  } from "../../lib/source";
  import { DEFAULT_THUMBNAIL } from "../../lib/constants";

  function esc(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
  }
  function openModal(el: HTMLElement) { el.classList.remove("hidden"); el.classList.add("flex"); }
  function closeModal(el: HTMLElement) { el.classList.add("hidden"); el.classList.remove("flex"); }

  const listEl = document.getElementById("list")!;
  const loading = document.getElementById("loading")!;
  const empty = document.getElementById("empty")!;
  const totalBadge = document.getElementById("totalBadge")!;
  const form = document.getElementById("sourceForm") as HTMLFormElement;
  const formTitle = document.getElementById("formTitle")!;
  const formSubtitle = document.getElementById("formSubtitle")!;
  const formError = document.getElementById("formError")!;
  const thumbUrl = document.getElementById("thumbUrl") as HTMLInputElement;
  const thumbFile = document.getElementById("thumbFile") as HTMLInputElement;
  const preview = document.getElementById("preview") as HTMLImageElement;
  const katSuggest = document.getElementById("katSuggest")!;
  const stackSuggest = document.getElementById("stackSuggest")!;

  let items: SourceItem[] = [];
  let editId: string | null = null;

  // ===== Preview =====
  function showPreview(src: string) {
    if (src) { preview.src = src; preview.classList.remove("hidden"); }
    else { preview.classList.add("hidden"); preview.removeAttribute("src"); }
  }
  document.querySelectorAll('input[name="thumbMode"]').forEach((r) => {
    r.addEventListener("change", () => {
      const mode = (r as HTMLInputElement).value;
      if (mode === "url") {
        thumbUrl.classList.remove("hidden");
        thumbFile.classList.add("hidden");
        showPreview(thumbUrl.value);
      } else {
        thumbUrl.classList.add("hidden");
        thumbFile.classList.remove("hidden");
      }
    });
  });
  thumbUrl.addEventListener("input", () => showPreview(thumbUrl.value));
  thumbFile.addEventListener("change", () => {
    const f = thumbFile.files?.[0];
    if (f) {
      const reader = new FileReader();
      reader.onload = () => showPreview(reader.result as string);
      reader.readAsDataURL(f);
    }
  });

  // ===== Rekomendasi badge =====
  function buildSuggestions() {
    const kats = Array.from(new Set(items.map((i) => i.kategori).filter(Boolean))).sort();
    katSuggest.innerHTML = kats.length
      ? `<span class="text-[0.65rem] text-gray-400">Saran:</span>` +
        kats.map((k) => `<button type="button" class="kat-badge text-[0.65rem] bg-gray-100 hover:bg-gray-200 text-gray-600 px-1.5 py-0.5 rounded" data-kat="${esc(k)}">${esc(k)}</button>`).join("")
      : "";

    const stacks = Array.from(new Set(items.flatMap((i) => i.stack))).sort();
    stackSuggest.innerHTML = stacks.length
      ? `<span class="text-[0.65rem] text-gray-400">Saran:</span>` +
        stacks.map((s) => `<button type="button" class="stack-badge text-[0.65rem] bg-gray-100 hover:bg-gray-200 text-gray-600 px-1.5 py-0.5 rounded" data-stack="${esc(s)}">${esc(s)}</button>`).join("")
      : "";

    katSuggest.querySelectorAll(".kat-badge").forEach((btn) => {
      btn.addEventListener("click", () => {
        (form.kategori as HTMLInputElement).value = (btn as HTMLButtonElement).dataset.kat!;
      });
    });

    stackSuggest.querySelectorAll(".stack-badge").forEach((btn) => {
      btn.addEventListener("click", () => {
        const input = form.stack as HTMLInputElement;
        const s = (btn as HTMLButtonElement).dataset.stack!;
        const current = parseStack(input.value);
        if (!current.includes(s)) current.push(s);
        input.value = current.join(" ");
      });
    });
  }

  // ===== Reset =====
  function resetForm() {
    editId = null;
    form.reset();
    (form.nama as HTMLInputElement).value = "";
    (form.kategori as HTMLInputElement).value = "";
    (form.downloadCount as HTMLInputElement).value = "0";
    thumbUrl.value = "";
    thumbUrl.classList.remove("hidden");
    thumbFile.classList.add("hidden");
    (document.querySelector('input[name="thumbMode"][value="url"]') as HTMLInputElement).checked = true;
    showPreview("");
    formError.classList.add("hidden");
    formTitle.textContent = "Tambah Source Code";
    formSubtitle.textContent = "Isi form lalu simpan.";
    listEl.querySelectorAll("[data-id]").forEach((el) => el.classList.remove("bg-blue-50"));
  }

  // ===== Load =====
  async function load() {
    loading.classList.remove("hidden");
    loading.textContent = "Memuat data...";
    listEl.classList.add("hidden");
    empty.classList.add("hidden");

    try {
      items = await getSources();
      loading.classList.add("hidden");
      totalBadge.textContent = `${items.length} item`;
      buildSuggestions();

      if (items.length === 0) { empty.classList.remove("hidden"); return; }

      listEl.classList.remove("hidden");
      listEl.innerHTML = items
        .map(
          (item) => `
          <div class="flex items-center gap-3 p-3 hover:bg-gray-50 cursor-pointer ${editId === item.id ? "bg-blue-50" : ""}" data-id="${item.id}">
            <img src="${esc(item.thumbnail || DEFAULT_THUMBNAIL)}" alt="" class="w-16 h-10 object-cover rounded bg-gray-100 shrink-0" loading="lazy" />
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm truncate">${esc(item.nama)}</div>
              <div class="flex flex-wrap items-center gap-1 mt-1">
                ${item.kategori ? `<span class="text-[0.65rem] text-blue-600 font-medium uppercase">${esc(item.kategori)}</span>` : ""}
                ${item.stack.slice(0, 3).map((s) => `<span class="text-[0.65rem] bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded">${esc(s)}</span>`).join("")}
                ${item.stack.length > 3 ? `<span class="text-[0.65rem] text-gray-400">+${item.stack.length - 3}</span>` : ""}
              </div>
            </div>
            <div class="text-xs text-gray-500 whitespace-nowrap">${item.downloadCount ?? 0}×</div>
            <button class="delete-btn text-red-600 hover:underline text-xs shrink-0" data-id="${item.id}">Hapus</button>
          </div>
        `
        )
        .join("");

      bindListActions();
    } catch (err: any) {
      loading.textContent = "Gagal memuat: " + (err?.message ?? "unknown");
    }
  }

  function bindListActions() {
    listEl.querySelectorAll("[data-id]").forEach((row) => {
      row.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).classList.contains("delete-btn")) return;
        const id = (row as HTMLElement).dataset.id!;
        const data = items.find((x) => x.id === id);
        if (!data) return;

        editId = id;
        (form.nama as HTMLInputElement).value = data.nama;
        (form.kategori as HTMLInputElement).value = data.kategori ?? "";
        (form.stack as HTMLInputElement).value = data.stack.join(" ");
        (form.download as HTMLInputElement).value = data.download;
        (form.downloadCount as HTMLInputElement).value = String(data.downloadCount ?? 0);
        thumbUrl.value = data.thumbnail;
        thumbUrl.classList.remove("hidden");
        thumbFile.classList.add("hidden");
        (document.querySelector('input[name="thumbMode"][value="url"]') as HTMLInputElement).checked = true;
        showPreview(data.thumbnail || DEFAULT_THUMBNAIL);
        formTitle.textContent = "Edit Source Code";
        formSubtitle.textContent = `Mengedit: ${data.nama}`;
        formError.classList.add("hidden");

        listEl.querySelectorAll("[data-id]").forEach((el) => el.classList.remove("bg-blue-50"));
        row.classList.add("bg-blue-50");
        form.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    listEl.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const id = (btn as HTMLButtonElement).dataset.id!;
        const item = items.find((x) => x.id === id);
        pendingDeleteId = id;
        document.getElementById("deleteName")!.textContent = item ? `"${item.nama}" akan dihapus permanen.` : "";
        openModal(deleteModal);
      });
    });
  }

  // ===== Submit =====
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    formError.classList.add("hidden");
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Menyimpan...";

    try {
      let thumbnailUrl = thumbUrl.value.trim();
      const mode = (document.querySelector('input[name="thumbMode"]:checked') as HTMLInputElement).value;
      if (mode === "upload" && thumbFile.files?.[0]) {
        const fd = new FormData();
        fd.append("file", thumbFile.files[0]);
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || "Upload gagal");
        }
        const data = await res.json();
        thumbnailUrl = data.url;
      }

      const payload = {
        nama: (form.nama as HTMLInputElement).value.trim(),
        thumbnail: thumbnailUrl,
        kategori: (form.kategori as HTMLInputElement).value.trim().toLowerCase(),
        stack: parseStack((form.stack as HTMLInputElement).value),
        download: (form.download as HTMLInputElement).value.trim(),
        downloadCount: parseInt((form.downloadCount as HTMLInputElement).value, 10) || 0,
      };

      if (editId) await updateSource(editId, payload);
      else await addSource(payload);

      resetForm();
      await load();
    } catch (err: any) {
      formError.textContent = "Gagal menyimpan: " + (err?.message ?? "unknown error");
      formError.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Simpan";
    }
  });

  document.getElementById("resetBtn")?.addEventListener("click", resetForm);
  document.getElementById("newBtn")?.addEventListener("click", () => {
    resetForm();
    form.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // ===== Modals =====
  const deleteModal = document.getElementById("deleteModal")!;
  const logoutModal = document.getElementById("logoutModal")!;
  let pendingDeleteId: string | null = null;

  document.getElementById("cancelDelete")?.addEventListener("click", () => closeModal(deleteModal));
  document.getElementById("confirmDelete")?.addEventListener("click", async () => {
    if (!pendingDeleteId) return;
    try {
      await deleteSource(pendingDeleteId);
      if (editId === pendingDeleteId) resetForm();
      pendingDeleteId = null;
      closeModal(deleteModal);
      await load();
    } catch (err) {
      console.error(err);
      closeModal(deleteModal);
    }
  });

  document.getElementById("logoutBtn")?.addEventListener("click", () => openModal(logoutModal));
  document.getElementById("cancelLogout")?.addEventListener("click", () => closeModal(logoutModal));
  document.getElementById("confirmLogout")?.addEventListener("click", async () => {
    await signOut(auth);
    window.location.href = "/admin/login";
  });

  load();
</script>